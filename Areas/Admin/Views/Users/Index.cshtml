@model HiveCore.Areas.Admin.Controllers.AdminUsersIndexViewModel
@{
    ViewData["Title"] = "Users";
    ViewData["Subtitle"] = $"{Model.TotalCount:N0} user(s) matching your filters";
}

<!-- STATS ROW -->
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3 col-lg">
        <a href="/Admin/Users?filter=" class="stat-pill @(string.IsNullOrEmpty(Model.Filter) ? "active" : "")">
            <span>All</span><strong>@Model.Stats.Total</strong>
        </a>
    </div>
    <div class="col-6 col-md-3 col-lg">
        <a href="/Admin/Users?filter=verified" class="stat-pill @(Model.Filter == "verified" ? "active" : "")">
            <span>Verified</span><strong>@Model.Stats.Verified</strong>
        </a>
    </div>
    <div class="col-6 col-md-3 col-lg">
        <a href="/Admin/Users?filter=suspended" class="stat-pill @(Model.Filter == "suspended" ? "active" : "")">
            <span>Suspended</span><strong>@Model.Stats.Suspended</strong>
        </a>
    </div>
    <div class="col-6 col-md-3 col-lg">
        <a href="/Admin/Users?filter=private" class="stat-pill @(Model.Filter == "private" ? "active" : "")">
            <span>Private</span><strong>@Model.Stats.Private</strong>
        </a>
    </div>
    <div class="col-6 col-md-3 col-lg">
        <a href="/Admin/Users?filter=deleted" class="stat-pill @(Model.Filter == "deleted" ? "active" : "")">
            <span>Deleted</span><strong>@Model.Stats.Deleted</strong>
        </a>
    </div>
</div>

<!-- SEARCH BAR -->
<form method="get" action="/Admin/Users" class="d-flex gap-2 mb-3">
    <input type="hidden" name="filter" value="@Model.Filter" />
    <div class="input-group">
        <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
        <input type="text" name="q" value="@Model.SearchQuery"
               class="form-control" placeholder="Search by username, display name or email…" />
        @if (!string.IsNullOrEmpty(Model.SearchQuery))
        {
            <a href="/Admin/Users?filter=@Model.Filter" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        }
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<!-- USERS TABLE -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th>User</th>
                    <th class="d-none d-md-table-cell">Email</th>
                    <th class="text-center d-none d-lg-table-cell">Followers</th>
                    <th class="text-center d-none d-lg-table-cell">Posts</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Joined</th>
                    <th style="width: 100px;"></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Users.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        No users found.
                    </td>
                </tr>
            }
            @foreach (var u in Model.Users)
            {
                <tr class="@(u.IsDeleted ? "table-secondary opacity-75" : "")">
                    <td>
                        <img src="@(u.AvatarUrl ?? "/images/default-avatar.png")"
                             class="rounded-circle" width="32" height="32" alt="" />
                    </td>
                    <td>
                        <div class="fw-semibold">
                            @u.DisplayName
                            @if (u.IsVerified)
                            {
                                <i class="bi bi-patch-check-fill text-primary ms-1" title="Verified"></i>
                            }
                            @if (u.IsPrivate)
                            {
                                <i class="bi bi-lock-fill text-warning ms-1" title="Private"></i>
                            }
                        </div>
                        <small class="text-muted">@@@u.Username</small>
                    </td>
                    <td class="d-none d-md-table-cell">
                        <small>@u.Email</small>
                    </td>
                    <td class="text-center d-none d-lg-table-cell">@u.FollowersCount</td>
                    <td class="text-center d-none d-lg-table-cell">@u.PostsCount</td>
                    <td>
                        @if (u.IsDeleted)
                        {
                            <span class="badge bg-secondary">Deleted</span>
                        }
                        else if (u.IsSuspended)
                        {
                            <span class="badge bg-danger">Suspended</span>
                        }
                        else if (u.IsVerified)
                        {
                            <span class="badge bg-primary">Verified</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success">Active</span>
                        }
                    </td>
                    <td class="d-none d-md-table-cell">
                        <small class="text-muted" title="@u.CreatedAt.ToString("u")">
                            @u.CreatedAt.ToString("yyyy-MM-dd")
                        </small>
                    </td>
                    <td class="text-end">
                        <a href="/Admin/Users/Details/@u.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @{
                var startPage = Math.Max(1, Model.CurrentPage - 3);
                var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 3);
            }
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?q=@Model.SearchQuery&filter=@Model.Filter&page=1">&laquo;</a>
            </li>
            @for (var i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?q=@Model.SearchQuery&filter=@Model.Filter&page=@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?q=@Model.SearchQuery&filter=@Model.Filter&page=@Model.TotalPages">&raquo;</a>
            </li>
        </ul>
    </nav>
}