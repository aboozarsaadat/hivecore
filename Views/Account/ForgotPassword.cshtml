@model HiveCore.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot password — HiveCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-dark.css" asp-append-version="true" />
</head>
<body class="auth-body">

<div class="auth-shell">
    <div class="auth-card">
        <a href="/" class="auth-brand">
            <i class="bi bi-hexagon-fill"></i>
            <span>HiveCore</span>
        </a>

        <h1 class="auth-title">Forgot password</h1>
        <p class="auth-subtitle">We'll email you a link to reset it</p>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" />
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-envelope"></i> Send reset link
            </button>
        </form>

        <p class="auth-footer">
            <a asp-action="Login" asp-controller="Account"><i class="bi bi-arrow-left"></i> Back to sign in</a>
        </p>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>