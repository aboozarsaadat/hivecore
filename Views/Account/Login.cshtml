@model HiveCore.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — HiveCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-dark.css" asp-append-version="true" />
</head>
<body class="auth-body">

<div class="auth-shell">
    <div class="auth-card">
        <a href="/" class="auth-brand">
            <i class="bi bi-hexagon-fill"></i>
            <span>HiveCore</span>
        </a>

        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Sign in to continue to your feed</p>

        <form asp-action="Login" asp-controller="Account" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="form-floating mb-3">
                <input asp-for="EmailOrUsername" class="form-control" placeholder="you@example.com" autocomplete="username" />
                <label asp-for="EmailOrUsername">Email or username</label>
                <span asp-validation-for="EmailOrUsername" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" autocomplete="current-password" />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                </div>
                <a href="/Account/ForgotPassword" class="small">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-box-arrow-in-right"></i> Sign in
            </button>
        </form>

        <div class="auth-divider"><span>or</span></div>

        <p class="auth-footer">
            Don't have an account? <a asp-action="Register" asp-controller="Account">Create one</a>
        </p>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>