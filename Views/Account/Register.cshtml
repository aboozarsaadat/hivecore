@model HiveCore.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create account — HiveCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-dark.css" asp-append-version="true" />
</head>
<body class="auth-body">

<div class="auth-shell">
    <div class="auth-card auth-card-wide">
        <a href="/" class="auth-brand">
            <i class="bi bi-hexagon-fill"></i>
            <span>HiveCore</span>
        </a>

        <h1 class="auth-title">Join HiveCore</h1>
        <p class="auth-subtitle">Create your account and start sharing</p>

        <form asp-action="Register" asp-controller="Account" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="form-floating mb-3">
                <input asp-for="DisplayName" class="form-control" placeholder="Jane Doe" />
                <label asp-for="DisplayName">Display name</label>
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>

            <div class="input-group mb-3">
                <span class="input-group-text">@@</span>
                <div class="form-floating flex-grow-1">
                    <input asp-for="Username" class="form-control" placeholder="jane" />
                    <label asp-for="Username">Username</label>
                </div>
            </div>
            <span asp-validation-for="Username" class="text-danger small d-block mb-2"></span>

            <div class="form-floating mb-3">
                <input asp-for="Email" type="email" class="form-control" placeholder="you@example.com" />
                <label asp-for="Email">Email</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm" />
                <label asp-for="ConfirmPassword">Confirm password</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="AcceptTerms" class="form-check-input" />
                <label asp-for="AcceptTerms" class="form-check-label small">
                    I agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>
                </label>
                <span asp-validation-for="AcceptTerms" class="text-danger small d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                <i class="bi bi-person-plus"></i> Create account
            </button>
        </form>

        <p class="auth-footer">
            Already have an account? <a asp-action="Login" asp-controller="Account">Sign in</a>
        </p>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
</body>
</html>