@model HiveCore.Models.ViewModels.TwoFactorViewModel
@{
    ViewData["Title"] = "Two-factor authentication";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <title>Two-factor — HiveCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-dark.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <div class="auth-card">
            <a href="/" class="auth-brand">
                <i class="bi bi-hexagon-fill"></i>
                <span>HiveCore</span>
            </a>

            <h1 class="auth-title">Two-factor</h1>
            <p class="auth-subtitle">Enter the code from your authenticator app</p>

            <form method="post" action="/Account/TwoFactor" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="form-floating mb-3">
                    <input asp-for="Code" class="form-control"
                           inputmode="numeric" autocomplete="one-time-code"
                           placeholder="123456" maxlength="7" autofocus />
                    <label asp-for="Code">Verification code</label>
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">Remember this device</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-shield-check"></i> Verify
                </button>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>