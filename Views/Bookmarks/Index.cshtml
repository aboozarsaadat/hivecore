@model IReadOnlyList<HiveCore.Models.DTOs.PostDto>
@{
    ViewData["Title"] = "Bookmarks";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<div class="page-column">

    <div class="page-header">
        <h1>
            <i class="bi bi-bookmark-fill me-2" style="color:var(--hc-accent);"></i>
            Bookmarks
        </h1>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bookmark"></i>
            <h3>No bookmarks yet</h3>
            <p>Tap the bookmark icon on any post to save it here for later.</p>
            <a href="/" class="btn btn-primary mt-3">
                <i class="bi bi-house-door"></i> Back to feed
            </a>
        </div>
    }
    else
    {
        <div class="feed-list">
            @foreach (var post in Model)
            {
                <partial name="_PostCard" model="post" />
            }
        </div>

        @if (totalPages > 1)
        {
            <partial name="_Pagination" model="@(new HiveCore.Models.ViewModels.PaginationViewModel
                     {
                         CurrentPage = currentPage,
                         TotalPages = totalPages,
                         BaseUrl = "/Bookmarks"
                     })" />
        }
    }
</div>

@section Scripts {
    <script src="~/js/post-actions.js" asp-append-version="true"></script>
}