@{
    ViewData["Title"] = "About";
}

<div class="static-page">
    <h1>About HiveCore</h1>
    <p>HiveCore is a chronological social microblog built with ASP.NET Core 8.</p>
    <p>We believe social networks should be simple, transparent, and user-first.</p>
    <h2>Our principles</h2>
    <ul>
        <li><strong>Chronological by default.</strong> No hidden algorithms.</li>
        <li><strong>Privacy first.</strong> You control who sees your content.</li>
        <li><strong>No engagement traps.</strong> No infinite scroll dark patterns.</li>
    </ul>
</div>