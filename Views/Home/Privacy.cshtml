@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="static-page">
    <h1>Privacy Policy</h1>
    <p class="text-muted">Last updated: @DateTime.UtcNow.ToString("MMMM d, yyyy")</p>

    <h2>1. Data We Collect</h2>
    <p>HiveCore collects minimal data required to operate a social microblogging service: account credentials, posts, comments, likes, follows, and profile information you provide voluntarily.</p>

    <h2>2. How We Use Your Data</h2>
    <p>Your data is used only to render your feed, enable interactions, and provide moderation tools. We do not sell or share your data with third parties.</p>

    <h2>3. Cookies</h2>
    <p>We use essential cookies for authentication and session management. You may clear them at any time in your browser.</p>

    <h2>4. Your Rights</h2>
    <p>You may export or delete your account at any time from the settings page.</p>

    <h2>5. Contact</h2>
    <p>For privacy inquiries, contact <a href="mailto:support@hivecore.app">support@hivecore.app</a>.</p>
</div>