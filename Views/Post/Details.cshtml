@model HiveCore.Models.ViewModels.PostDetailsViewModel
@{
    ViewData["Title"] = "Post";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<div class="page-column">

    <div class="page-header">
        <a href="javascript:history.back()" class="page-back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1>Post</h1>
    </div>

    <!-- Main post -->
    <partial name="_PostCard" model="Model.Post" />

    <!-- Comment form -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="comment-form-wrapper">
            <partial name="_CommentForm" model="Model.NewComment" />
        </div>
    }
    else
    {
        <div class="comment-login-prompt">
            <a href="/Account/Login">Sign in</a> to comment
        </div>
    }

    <!-- Comments -->
    <section class="comments-section">
        <h2 class="section-title">
            Comments
            @if (Model.Post.CommentsCount > 0)
            {
                <span class="section-count">@Model.Post.CommentsCount</span>
            }
        </h2>

        @if (!Model.Comments.Any())
        {
            <p class="text-muted text-center py-4">No comments yet. Be the first!</p>
        }
        else
        {
            <div class="comments-list">
                @foreach (var c in Model.Comments)
                {
                    <partial name="_CommentItem" model="c" />
                }
            </div>

            @if (totalPages > 1)
            {
                <partial name="_Pagination" model="@(new HiveCore.Models.ViewModels.PaginationViewModel {
                    CurrentPage = currentPage,
                    TotalPages = totalPages,
                    BaseUrl = $"/Post/{Model.Post.Id}"
                })" />
            }
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/post-actions.js" asp-append-version="true"></script>
    <script src="~/js/comment.js" asp-append-version="true"></script>
}