@model HiveCore.Models.ViewModels.PostViewModel
@{
    ViewData["Title"] = "Edit post";
}

<div class="page-column">
    <div class="page-header">
        <a href="/Post/@Model.Id" class="page-back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1>Edit post</h1>
    </div>

    <partial name="_PostForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/post-edit-media.js" asp-append-version="true"></script>
    <script src="~/js/post-actions.js" asp-append-version="true"></script>
}