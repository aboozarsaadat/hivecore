@model HiveCore.Models.ViewModels.PaginationViewModel
@{
    if (Model.TotalPages <= 1) { return; }

    var start = Math.Max(1, Model.CurrentPage - 2);
    var end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

    string BuildUrl(int page)
    {
        var sep = Model.BaseUrl.Contains('?') ? '&' : '?';
        return $"{Model.BaseUrl}{sep}page={page}";
    }
}

<nav class="app-pagination" aria-label="Pagination">
    <a href="@BuildUrl(1)" class="page-btn @(Model.CurrentPage == 1 ? "disabled" : "")">
        <i class="bi bi-chevron-double-left"></i>
    </a>
    <a href="@BuildUrl(Math.Max(1, Model.CurrentPage - 1))" class="page-btn @(Model.CurrentPage == 1 ? "disabled" : "")">
        <i class="bi bi-chevron-left"></i>
    </a>

    @for (var i = start; i <= end; i++)
    {
        <a href="@BuildUrl(i)" class="page-btn @(i == Model.CurrentPage ? "active" : "")">@i</a>
    }

    <a href="@BuildUrl(Math.Min(Model.TotalPages, Model.CurrentPage + 1))" class="page-btn @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
        <i class="bi bi-chevron-right"></i>
    </a>
    <a href="@BuildUrl(Model.TotalPages)" class="page-btn @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
        <i class="bi bi-chevron-double-right"></i>
    </a>
</nav>