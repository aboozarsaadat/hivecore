@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUser = User.Identity?.Name ?? "you";
    var displayName = User.FindFirst("uname")?.Value ?? currentUser;
}

<aside class="app-sidebar" id="appSidebar">
    <a href="/" class="app-brand">
        <i class="bi bi-hexagon-fill"></i>
        <span class="app-brand-name">HiveCore</span>
    </a>

    <nav class="app-nav">
        <a href="/" class="app-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
            <i class="bi bi-house-door"></i>
            <span>Home</span>
        </a>
        <a href="/Explore" class="app-nav-link @(currentController == "Explore" ? "active" : "")">
            <i class="bi bi-compass"></i>
            <span>Explore</span>
        </a>
        <a href="/Notification" class="app-nav-link @(currentController == "Notification" ? "active" : "")">
            <i class="bi bi-bell"></i>
            <span>Notifications</span>
            <span class="app-badge" id="navNotifBadge" style="display:none;">0</span>
        </a>
        <a href="/Bookmarks" class="app-nav-link @(currentController == "Bookmark" ? "active" : "")">
            <i class="bi bi-bookmark"></i>
            <span>Bookmarks</span>
        </a>
        <a href="/Profile/@displayName" class="app-nav-link @(currentController == "Profile" && currentAction == "Index" ? "active" : "")">
            <i class="bi bi-person"></i>
            <span>Profile</span>
        </a>
        <a href="/Profile/Settings" class="app-nav-link @(currentAction == "Settings" ? "active" : "")">
            <i class="bi bi-gear"></i>
            <span>Settings</span>
        </a>
    </nav>

    <a href="/Post/Create" class="app-post-btn">
        <i class="bi bi-feather"></i>
        <span>New post</span>
    </a>

    <div class="app-sidebar-footer">
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="app-nav-link border-0 bg-transparent w-100 text-start">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sign out</span>
            </button>
        </form>
    </div>
</aside>