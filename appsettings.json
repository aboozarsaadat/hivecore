{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=aspnet-hivecoredb2;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Redis": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "HiveCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/hivecore-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "HiveCore"
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "https://hivecore.app",
    "Audience": "https://hivecore.app",
    "Key": "CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },

  "Identity": {
    "RequireConfirmedEmail": true,
    "RequireConfirmedPhoneNumber": false,
    "DefaultLockoutMinutes": 15,
    "MaxFailedAccessAttempts": 5
  },

  "ExternalAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": ""
    },
    "Apple": {
      "ClientId": "",
      "TeamId": "",
      "KeyId": "",
      "PrivateKey": ""
    }
  },

  "Email": {
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@hivecore.app",
    "FromName": "HiveCore",
    "UseDefaultCredentials": false
  },

  "Sms": {
    "Provider": "Twilio",
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": ""
  },

  "Media": {
    "UploadsRoot": "wwwroot/uploads",
    "MaxAvatarSizeMb": 5,
    "MaxCoverSizeMb": 10,
    "MaxPostImageSizeMb": 15,
    "MaxPostVideoSizeMb": 100,
    "AllowedImageExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ],
    "AllowedVideoExtensions": [ ".mp4", ".webm", ".mov" ],
    "ThumbnailWidth": 400,
    "ThumbnailHeight": 400,
    "MaxImageDimension": 4096
  },

  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "FeedPageSize": 25,
    "CommentsPageSize": 30,
    "NotificationsPageSize": 20
  },

  "Cache": {
    "DefaultExpirationMinutes": 10,
    "FeedCacheMinutes": 2,
    "ProfileCacheMinutes": 5,
    "TrendingCacheMinutes": 5
  },

  "Features": {
    "EnableRegistration": true,
    "EnableEmailVerification": true,
    "EnableTwoFactorAuth": true,
    "EnableDirectMessages": true,
    "EnableStories": true,
    "EnableLiveStreaming": false,
    "EnableAnalytics": true,
    "EnableMusicOnProfile": true,
    "EnableCustomThemes": true,
    "EnableNotifications": true,
    "EnableExplore": true,
    "EnableBookmarks": true,
    "EnableReposts": true,
    "EnableQuotes": true,
    "MaintenanceMode": false
  },

  "Moderation": {
    "EnableAutoModeration": true,
    "BlockedWords": [ "spam", "scam", "abuse" ],
    "MaxReportsBeforeReview": 5,
    "AutoHideReportedPosts": false
  },

  "Security": {
    "EnableIpRateLimiting": true,
    "EnableCsp": true,
    "EnableHsts": true,
    "CspPolicy": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; connect-src 'self' wss: https:;"
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "post:/Account/Login",
        "Period": "5m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/Account/Register",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/posts",
        "Period": "1m",
        "Limit": 20
      },
      {
        "Endpoint": "post:/api/comments",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "post:/api/likes",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },

  "IpRateLimitPolicies": {
    "IpRules": []
  },

  "HealthChecks": {
    "Enabled": true,
    "Path": "/health"
  },

  "HiveCore": {
    "SiteName": "HiveCore",
    "SiteUrl": "https://hivecore.app",
    "SupportEmail": "support@hivecore.app",
    "DefaultAvatarUrl": "/images/default-avatar.png",
    "DefaultCoverUrl": "/images/default-cover.png",
    "MaxBioLength": 300,
    "MaxDisplayNameLength": 50,
    "MaxUsernameLength": 30,
    "MinUsernameLength": 3,
    "MaxPostLength": 2000,
    "MaxCommentLength": 1000,
    "MaxHashtagsPerPost": 10,
    "MaxMentionsPerPost": 20
  }
}